NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# true = show 4 sample properties instead of reading the database (for demos). Set to false for real data.
NEXT_PUBLIC_DEMO_DATA=true

# Public address of this site (Smile ID sends results to NEXT_PUBLIC_SITE_URL/api/smile/webhook, so it must be reachable over HTTPS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Smile ID. Leave these empty to use manual identity review instead.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox
# Server-only. Never expose this key in the browser. Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (wallet funding). Server-only secret key from the Paystack dashboard.
PAYSTACK_SECRET_KEY=
# Any long random string. Protects the daily rent job at /api/cron/rent-due.
CRON_SECRET=

# Email reminders (Resend). Leave empty to skip reminders.
RESEND_API_KEY=
EMAIL_FROM="RENTLIFTED <noreply@yourdomain.com>"
